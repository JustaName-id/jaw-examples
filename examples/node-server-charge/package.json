{
  "name": "jaw-node-server-charge",
  "version": "0.1.0",
  "private": true,
  "nx": {
    "name": "node-server-charge",
    "projectType": "application",
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsx watch src/index.ts",
          "cwd": "{projectRoot}"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "outputs": ["{projectRoot}/dist"],
        "options": {
          "command": "tsc",
          "cwd": "{projectRoot}"
        }
      },
      "start": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node dist/index.js",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@jaw.id/core": "latest",
    "express": "^4",
    "viem": "^2"
  },
  "devDependencies": {
    "@types/express": "^4",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
