# Get your API key at https://dashboard.jaw.id
JAW_API_KEY=

# Private key of the EOA to upgrade via EIP-7702
# The EOA address is preserved as the smart account address
PRIVATE_KEY=0x

# Optional: paymaster URL for gas sponsorship (e.g. Pimlico)
# If not set, the EOA must hold ETH for gas
PAYMASTER_URL=
