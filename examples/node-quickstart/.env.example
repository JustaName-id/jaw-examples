# Get your API key at https://dashboard.jaw.id
JAW_API_KEY=your_api_key_here

# Private key of the wallet that will sign and send transactions
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRIVATE_KEY=0xyour_private_key_here

# Address that will receive the demo ETH transfers (Steps 3 & 4)
# Your account needs ~0.001 ETH on Base to cover amounts + gas
RECIPIENT_ADDRESS=0xyour_recipient_address_here
